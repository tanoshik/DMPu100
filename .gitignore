# .gitignore (DMPu100)
.Rhistory
.RData
.Rproj.user/
.Ruserdata

# runtime outputs
output/
logs/
nohup.out
*.log

# Rcpp build cache
src/.rcpp_cache/

# Common build artifacts
*.o
*.so
*.dll
*.dylib
*.exe
*.bak

# Bench / consistency outputs
bench/*.csv
test/bench/*.csv

# Large data (keep in dist zip only)
data/legacy
data/slices

# editor / temp
*.tmp
*_temp.*
*.swp
.DS_Store
Thumbs.db

# safety: local scratch
scratch_*.R
debug_*.R
notes_*.md

# Root-level adhoc scripts (temporary)
/bench_*.sh
/memlog.ps1
